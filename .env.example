# ==========================================================
# 🌐 API Keys for Media Tracker Bot
# Cập nhật: 2025-07-01
# 
# Chú ý:
# - Không commit API keys thật lên Git.
# - Sao chép file này thành `.env` và điền giá trị thật.
# ==========================================================

# === API Keys ===
# API key của OpenAI (hoặc nhà cung cấp model khác)
OPENAI_API_KEY=sk-proj-REPLACE_WITH_YOUR_KEY

# Nếu dùng Groq hoặc provider khác, thêm key tương ứng
GROQ_API_KEY=REPLACE_WITH_YOUR_KEY

# Gemini
GOOGLE_API_KEY=REPLACE_WITH_YOUR_KEY

# ==========================================================
# === Model Providers & Model Config ===
# DEFAULT_MODEL_PROVIDER: openai, groq, v.v.
DEFAULT_MODEL_PROVIDER=openai
DEFAULT_MODEL_ID=gpt-4o-mini

# Model của OpenAI (ví dụ: gpt-4o-mini, gpt-3.5-turbo)
OPENAI_MODEL=gpt-4o-mini

# Model của Groq (ví dụ: llama-3.1-70b-instruct)
GROQ_MODEL=llama-3.1-70b-versatile

# Model của Gemini
GEIMINI_MODEL=gemini-2.0-flash

# ==========================================================
# === Crawler Settings ===
# Số lượng tối đa tác vụ crawl chạy song song
CRAWL4AI_MAX_CONCURRENT=5

# Giới hạn thời gian crawl 1 nguồn (phút)
CRAWL4AI_TIMEOUT=30

# ==========================================================
# === Token & Auth Settings ===
# Thời gian hết hạn token (phút)
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ==========================================================
# === CORS Settings ===
# Danh sách domain được phép gọi API (phân tách bằng dấu phẩy)
# Ví dụ: http://localhost:5173,https://app.client.com
ALLOWED_ORIGINS=http://localhost:5173

# (Tùy chọn) Regex cho phép nhiều subdomain
# Ví dụ: ^https://([a-z0-9-]+\.)?client\.com$
ALLOWED_ORIGIN_REGEX=
CORS_MAX_AGE=84600

# ==========================================================
# === Logging Settings ===
# Mức độ log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ==========================================================
# === Celery / Redis Settings ===
# Bật Celery qua .env: TRUE thì sẽ dùng Celery + Redis; FALSE chạy FastAPI bình thường
# Accepted truthy values: 1, true, yes, on (case-insensitive)
CELERY_AVAILABLE=FALSE

# Mặc định broker/backend (mặc định sử dụng Redis local)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
