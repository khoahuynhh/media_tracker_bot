    <script>
      document.querySelectorAll(".modal").forEach((modal) => {
        modal.addEventListener("show.bs.modal", () => {
          const dialog = modal.querySelector(".modal-dialog");
          if (dialog) {
            dialog.classList.add("animate__animated", "animate__fadeInDown");
          }
        });

        modal.addEventListener("hidden.bs.modal", () => {
          const dialog = modal.querySelector(".modal-dialog");
          if (dialog) {
            dialog.classList.remove("animate__animated", "animate__fadeInDown");
          }
        });
      });
    </script>

    <script>
      const modalCache = {};
      function showModal(id) {
        const el = document.getElementById(id);
        if (!modalCache[id]) modalCache[id] = new bootstrap.Modal(el);
        modalCache[id].show();
      }

      // Khi bất kỳ modal nào đóng, nếu không còn modal đang mở -> unlock body + dọn backdrop
      document.addEventListener('hidden.bs.modal', () => {
        setTimeout(() => {
          if (document.querySelectorAll('.modal.show').length === 0) {
            document.body.classList.remove('modal-open');
            document.body.style.removeProperty('padding-right');
            document.querySelectorAll('.modal-backdrop').forEach(b => b.remove());
          }
        }, 50); // đợi Bootstrap hoàn tất animation rồi mới dọn
      });
    </script>

    <script>
      async function togglePauseResume() {
        if (!currentSessionId) return;

        const btn = document.getElementById("pauseResumeBtn");
        const labelEl = document.getElementById("pauseResumeBtnText"); const currentLabel = labelEl ? labelEl.textContent.trim().toLowerCase() : (btn.innerText || "").trim().toLowerCase(); const isCurrentlyPaused = currentLabel.includes("resume");

        const endpoint = isCurrentlyPaused
          ? `/api/tasks/${currentSessionId}/resume`
          : `/api/tasks/${currentSessionId}/pause`;

        try {
          await fetch(endpoint, {
            method: "POST",
            headers: {
              Authorization: `Bearer ${localStorage.getItem("token")}`,
            },
          });

          if (labelEl) labelEl.textContent = (typeof t === "function") ? (isCurrentlyPaused ? t("pause") : t("resume")) : (isCurrentlyPaused ? "Pause" : "Resume"); loadStatus(); // Gọi lại để cập nhật UI
        } catch (err) {
          console.error(err);
        }
      }
    </script>

