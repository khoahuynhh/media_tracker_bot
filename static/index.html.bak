            <!-- Crawler Settings -->
            <div class="card">
              <div class="card-header">
                <h6 class="card-title mb-0">
                  <i class="fas fa-cog me-2"></i>
                  Crawler Settings
                </h6>
              </div>
              <div class="card-body">
                <form id="settingsForm">
                  <div class="mb-3">
                    <label class="form-label">Khoảng thời gian crawl (ngày)</label>
                    <input type="number" class="form-control" id="dateRangeDays" min="1" max="365" value="30" />
                  </div>
                  <div class="mb-3">
                    <label class="form-label">Số bài tối đa mỗi source</label>
                    <input type="number" class="form-control" id="maxArticlesPerSource" min="1" max="1000" value="50" />
                  </div>
                  <div class="mb-3">
                    <label class="form-label">Timeout (giây)</label>
                    <input type="number" class="form-control" id="crawlTimeout" min="5" max="300" value="30" />
                  </div>
                  <div class="mb-3">
                    <label class="form-label">Keywords (JSON format)</label>
                    <textarea class="form-control" id="keywordsConfig" rows="8"></textarea>
                  </div>
                </form>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
              Hủy
            </button>
            <button type="button" class="btn btn-primary" onclick="saveSettings()">
              Lưu cài đặt
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- Override auth mode to be i18n-aware -->
  <script>
    (function () {
      const to = (typeof t === 'function') ? t : (k) => k;
      const override = function (register) {
        try { window.isRegisterMode = register; } catch (_) { }
        document.body.dataset.authMode = register ? 'register' : 'login';
        const title = document.getElementById('authTitle'); if (title) title.textContent = register ? to('register') : to('login');
        const wrap = document.getElementById('confirmPasswordWrap'); if (wrap) wrap.style.display = register ? 'block' : 'none';
        const btn = document.getElementById('authSubmitBtn'); if (btn) btn.textContent = register ? to('register') : to('login');
        const toggle = document.getElementById('toggleAuthText');
        if (toggle) {
          toggle.innerHTML = register
            ? `${to('haveAccount').split('?')[0]}? <a href="#" id="toggleAuthLink">${to('login')}</a>`
            : `${to('noAccount').split('?')[0]}? <a href="#" id="toggleAuthLink">${to('register')}</a>`;
        }
        if (typeof bindToggleLink === 'function') bindToggleLink();
      };
      window.setAuthMode = override;
    })();
  </script>

</body>

</html>
